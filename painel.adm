        // AUTENTICAÇÃO E PAINEL ADMINISTRATIVO COM SENHA
        function requestAdminAccess() {
            if (isAdminAuthenticated) {
                toggleAdminPanel();
            } else {
                document.getElementById('admin-pass-input').value = '';
                document.getElementById('password-modal').classList.remove('hidden');
            }
        }

        function verifyAdminPassword(e) {
            e.preventDefault();
            const pass = document.getElementById('admin-pass-input').value;
            if (pass === ADMIN_PASS || pass === 'smurf') {
                isAdminAuthenticated = true;
                closeModal('password-modal');
                toggleAdminPanel();
                showToast("Acesso administrativo concedido!");
            } else {
                showToast("Senha incorreta! Tente 1234.");
            }
        }

        function lockAdminPanel() {
            isAdminAuthenticated = false;
            document.getElementById('admin-panel').classList.add('hidden');
            showToast("Painel bloqueado com sucesso.");
        }

        function toggleAdminPanel() {
            const panel = document.getElementById('admin-panel');
            panel.classList.toggle('hidden');
            
            if (!panel.classList.contains('hidden')) {
                // Cálculo do Faturamento e Quantidade de Pedidos
                document.getElementById('admin-sales').innerText = `R$ ${totalSales.toFixed(2)}`;
                document.getElementById('admin-count').innerText = ordersCount;

                // Contagem detalhada dos itens para Mais e Menos pedidos
                const itemCounts = {};
                ordersHistory.forEach(order => {
                    order.items.forEach(item => {
                        const qty = item.qty || 1;
                        itemCounts[item.title] = (itemCounts[item.title] || 0) + qty;
                    });
                });

                let mostPopular = "Nenhum ainda";
                let leastPopular = "Nenhum ainda";
                const entries = Object.entries(itemCounts);

                if (entries.length > 0) {
                    entries.sort((a, b) => b[1] - a[1]);
                    mostPopular = `${entries[0][0]} (${entries[0][1]}x)`;
                    leastPopular = `${entries[entries.length - 1][0]} (${entries[entries.length - 1][1]}x)`;
                }

                document.getElementById('admin-most-popular').innerText = mostPopular;
                document.getElementById('admin-least-popular').innerText = leastPopular;

                // Renderização detalhada do histórico de pedidos
                const ordersContainer = document.getElementById('admin-orders-list');
                if (ordersHistory.length === 0) {
                    ordersContainer.innerHTML = `<p class="text-xs text-gray-400 text-center py-6">Nenhum pedido efetuado nesta sessão ainda.</p>`;
                } else {
                    ordersContainer.innerHTML = ordersHistory.map(o => `
                        <div class="p-3.5 rounded-2xl bg-royalDark-950 border border-sapphire-500/30 text-xs text-white space-y-2">
                            <div class="flex justify-between items-center font-bold border-b border-royalDark-800 pb-2">
                                <span class="text-goldAccent-400 flex items-center gap-2">
                                    <i class="fa-solid fa-hashtag text-[10px]"></i> ${o.id} • <span class="text-gray-300 font-normal">${o.time}</span>
                                </span>
                                <span class="text-emerald-400 font-extrabold text-sm">Total: R$ ${o.total.toFixed(2)}</span>
                            </div>
                            <div class="space-y-1 pt-1">
                                <span class="text-[10px] text-gray-400 uppercase font-semibold block">Itens Solicitados:</span>
                                ${o.items.map(i => `
                                    <div class="flex justify-between items-center text-[11px] text-gray-300 bg-royalDark-900/70 px-2.5 py-1 rounded-lg">
                                        <span><strong class="text-goldAccent-400">${i.qty || 1}x</strong> ${i.title}</span>
                                        <span class="text-gray-400">R$ ${(i.price * (i.qty || 1)).toFixed(2)}</span>
                                    </div>
                                me`).join('')}
                            </div>
                        </div>
                    `).join('');
                }
            }
        }

        function handleReservationSubmit(e) {
            e.preventDefault();
            const dateInput = document.getElementById('reservation-date-input');
            const selectedDate = dateInput ? dateInput.value : '';

            if (selectedDate) {
                const currentCount = dailyReservations[selectedDate] || 0;
                if (currentCount >= MAX_RESERVATIONS_PER_DAY) {
                    showToast("Desculpe, esse dia atingiu o limite máximo de 9 reservas!");
                    return;
                }
                dailyReservations[selectedDate] = currentCount + 1;
                renderVIPCalendar();
            }

            showToast("Solicitação de reserva VIP enviada com sucesso!");
            e.target.reset();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3500);
        }
    </script>
</body>
</html>
